// Paste this file directly into https://dbdiagram.io/d to generate
// clean ER and Logical Schema diagrams for Chapters 3 & 4.

Project BiteFlow_Online_Food_Ordering_Group15 {
  database_type: 'PostgreSQL'
  Note: 'CMPE341 Database Design & Management - Group 15 (8 Entities)'
}

Table users {
  user_id int [pk, increment]
  username varchar(50) [not null, unique]
  email varchar(120) [not null, unique]
  password_hash text [not null]
  role varchar(20) [not null, default: 'customer', note: "CHECK (role IN ('admin', 'customer'))"]
  full_name varchar(100) [not null]
  phone varchar(25) [not null]
  address text [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table restaurants {
  restaurant_id int [pk, increment]
  name varchar(100) [not null]
  cuisine_type varchar(50) [not null]
  address text [not null]
  phone varchar(25) [not null]
  delivery_time_min int [not null, default: 30]
  min_order_amount numeric(10,2) [not null, default: 0.00]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table categories {
  category_id int [pk, increment]
  name varchar(60) [not null, unique]
  description varchar(255)
}

Table menu_items {
  item_id int [pk, increment]
  restaurant_id int [not null, ref: > restaurants.restaurant_id]
  category_id int [not null, ref: > categories.category_id]
  name varchar(100) [not null]
  description text
  price numeric(10,2) [not null]
  is_available boolean [not null, default: true]
}

Table orders {
  order_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  restaurant_id int [not null, ref: > restaurants.restaurant_id]
  order_date timestamp [not null, default: `CURRENT_TIMESTAMP`]
  status varchar(20) [not null, default: 'Pending']
  total_amount numeric(10,2) [not null]
  delivery_address text [not null]
  notes varchar(255)
}

Table order_items {
  order_item_id int [pk, increment]
  order_id int [not null, ref: > orders.order_id]
  item_id int [not null, ref: > menu_items.item_id]
  quantity int [not null]
  unit_price numeric(10,2) [not null]

  indexes {
    (order_id, item_id) [unique]
  }
}

Table payments {
  payment_id int [pk, increment]
  order_id int [not null, unique, ref: - orders.order_id]
  payment_method varchar(30) [not null]
  payment_status varchar(20) [not null, default: 'Pending']
  amount numeric(10,2) [not null]
  paid_at timestamp
}

Table reviews {
  review_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  restaurant_id int [not null, ref: > restaurants.restaurant_id]
  rating int [not null, note: 'CHECK (rating BETWEEN 1 AND 5)']
  comment text [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}
