// CMPE341 - Group 15 - Chapter 4: Logical Data Model (15 Normalized Tables)
// Paste into https://dbdiagram.io/d if you want an interactive SQL/diagram view.

Project BiteFlow_Online_Food_Ordering_Group15 {
  database_type: 'PostgreSQL'
  Note: 'Mapped from 10-Entity EER Diagram -> 15 Normalized Relational Tables'
}

Table member {
  member_id int [pk, increment]
  email varchar(120) [not null, unique]
  first_name varchar(60) [not null]
  middle_name varchar(60)
  last_name varchar(60) [not null]
  password_hash text [not null]
  phone_number varchar(25) [not null]
}

Table admin {
  admin_id int [pk, increment]
  member_id int [not null, unique, ref: - member.member_id]
}

Table customer {
  customer_id int [pk, increment]
  member_id int [not null, unique, ref: - member.member_id]
  gender varchar(25) [not null]
}

Table address {
  address_id int [pk, increment]
  address_title varchar(60)
  province varchar(60) [not null]
  district varchar(60) [not null]
  subdistrict varchar(60) [not null]
  neighborhood varchar(80) [not null]
  street varchar(120) [not null]
  floor varchar(20)
  building_no varchar(20)
  latitude numeric(9,6) [not null]
  longitude numeric(9,6) [not null]
  details text
}

Table customer_address {
  customer_id int [pk, ref: > customer.customer_id]
  address_id int [pk, ref: > address.address_id]
}

Table customer_payment_info {
  payment_info_id int [pk, increment]
  customer_id int [not null, ref: > customer.customer_id]
  saved_payment_info varchar(120) [not null]
}

Table restaurant {
  restaurant_id int [pk, increment]
  address_id int [not null, unique, ref: - address.address_id]
  name varchar(100) [not null]
  phone_number varchar(25) [not null]
  email varchar(120) [not null]
  min_order_amount numeric(10,2) [not null, default: 0.00]
}

Table restaurant_manager {
  manager_id int [pk, increment]
  member_id int [not null, unique, ref: - member.member_id]
  restaurant_id int [not null, ref: > restaurant.restaurant_id]
}

Table restaurant_working_hours {
  restaurant_id int [pk, ref: > restaurant.restaurant_id]
  day varchar(15) [pk]
  opening_time time [not null]
  closing_time time [not null]
}

Table restaurant_delivery_type {
  restaurant_id int [pk, ref: > restaurant.restaurant_id]
  delivery_type varchar(30) [pk]
}

Table restaurant_cuisine {
  restaurant_id int [pk, ref: > restaurant.restaurant_id]
  cuisine_type varchar(50) [pk]
}

Table product {
  product_id int [pk, increment]
  restaurant_id int [not null, ref: > restaurant.restaurant_id]
  product_name varchar(100) [not null]
  description text
  category varchar(30) [not null]
  price numeric(10,2) [not null]
  is_available boolean [not null, default: true]
  discount_available boolean [not null, default: false]
  discount_percentage numeric(5,2)
}

Table orders {
  order_id int [pk, increment]
  restaurant_id int [not null, ref: > restaurant.restaurant_id]
  customer_id int [not null, ref: > customer.customer_id]
  delivery_address_id int [ref: > address.address_id]
  delivery_type varchar(30) [not null]
  payment_method varchar(30) [not null]
  order_date timestamp [not null]
  order_status varchar(30) [not null]
  estimated_delivery_time int [not null]
  total_price numeric(10,2) [not null]
}

Table order_items {
  order_id int [pk, ref: > orders.order_id]
  product_id int [pk, ref: > product.product_id]
  unit_price numeric(10,2) [not null]
  quantity int [not null]
}

Table restaurant_review {
  restaurant_review_id int [pk, increment]
  customer_id int [not null, ref: > customer.customer_id]
  restaurant_id int [not null, ref: > restaurant.restaurant_id]
  order_id int [not null, unique, ref: - orders.order_id]
  rating int [not null]
  comment text
  date timestamp [not null]
}
